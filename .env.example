# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Database & Storage
DB_FILE=/app/data/data.db
UPLOAD_DIR=/app/uploads

# JWT & Auth
JWT_SECRET=change_this_in_production
API_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Security
# CSRF: desactivado en el código (la API se autentica con Bearer/JWT, no con
# cookies), así que no hay variables CSRF_* que configurar.
# Saltos de proxy de confianza (1 = detrás de Plesk/nginx/Caddy). Solo si el
# puerto de la app NO es accesible directamente desde internet. 0 = desactivado.
TRUST_PROXY=1

# HTTPS & HSTS
FORCE_HTTPS=true
HSTS_ENABLED=true
PUBLIC_URL=https://localhost:3000
SSL_CERT_PATH=/app/certs/cert.pem
SSL_KEY_PATH=/app/certs/key.pem

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8825

# Email (SMTP)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_FROM=no-reply@gestor-tareas.local

# Rate Limiting
# Siempre activos en /auth (independientes de RATE_LIMIT_ENABLED):
#   intentos fallidos de login/registro/reset por IP, y forgot-password por IP.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
FORGOT_RATE_LIMIT_MAX=5
FORGOT_RATE_LIMIT_WINDOW_MS=3600000
# Limitador global de /v1 y /api: solo se activa con RATE_LIMIT_ENABLED=1.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# API Public
PUBLIC_HOST=localhost:3000
PUBLIC_API_IDENTIFIER=gestor-tareas-api

# Image Handling
ALLOW_HTTP_IMAGES=false

# Backup/Maintenance
BACKUP_DIR=/app/data/backups
SHUTDOWN_GRACE_MS=3000
SHUTDOWN_FORCE_MS=6000

# Advanced (optional)
SNAPSHOT_EXCLUDE=node_modules,uploads
DRY_RUN=false
PRUNE=false
MAX_DELETE=1000

# ===== PARA PRODUCCIÓN: GMAIL CON CONTRASEÑA DE APLICACIÓN =====
# Requisito previo: activar 2FA en tu cuenta Google y generar una
# Contraseña de aplicación en https://myaccount.google.com/apppasswords
# Descomenta y rellena con tus credenciales:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu_cuenta@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="Gestor de Tareas" <tu_cuenta@gmail.com>
# Luego comenta las líneas de Mailpit arriba
