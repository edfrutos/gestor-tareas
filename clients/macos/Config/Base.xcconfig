// Ajustes compartidos por los tres configs (Debug, Release-MAS, Release-DevID).

// El nombre de producto DEBE coincidir con el nombre del target (sin espacios):
// evita el desajuste de TEST_HOST y simplifica firma/archivado.
// El nombre visible para el usuario ("Gestor de Tareas") vive en CFBundleDisplayName
// (GestorTareasApp/Resources/Info.plist).
PRODUCT_NAME = GestorTareas
PRODUCT_BUNDLE_IDENTIFIER = com.edefrutos.gestortareas

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 2

SWIFT_VERSION = 5.9
MACOSX_DEPLOYMENT_TARGET = 14.0

INFOPLIST_FILE = GestorTareasApp/Resources/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Concurrencia: 'targeted' en el Hito 0; subir a 'complete' cuando el núcleo esté estable.
SWIFT_STRICT_CONCURRENCY = targeted

// >>> Rellena con tu Team ID de Apple Developer (Membership details).
DEVELOPMENT_TEAM = V29BTBRY6G
