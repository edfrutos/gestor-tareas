#include "Base.xcconfig"

// Canal 1: Mac App Store. Certificado "Apple Distribution" + perfil de aprovisionamiento.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Distribution
CODE_SIGN_ENTITLEMENTS = Signing/GestorTareas-MAS.entitlements

// >>> Nombre EXACTO del provisioning profile de la App para Mac App Store.
PROVISIONING_PROFILE_SPECIFIER = GestorTareas

ENABLE_HARDENED_RUNTIME = YES
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule

// Distingue este canal en código (ver UpdateChecker/RootView): la build de
// Mac App Store nunca debe enlazar a una descarga fuera de la App Store, ya
// que Apple la actualiza sola. Ausente en Debug/Release-DevID a propósito.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = MAS_BUILD
